    { "id": "card", "outs": ["UI/Panels/UI_Panel_Card.png", "UI/Panels/UI_RewardBlock_Normal.png", "UI/Panels/UI_DayTile_Normal.png"], "nine": [32, 32, 32, 32] },
    { "id": "card_light", "outs": ["UI/Panels/UI_Panel_Card_Light.png", "UI/Panels/UI_DayTile_Bonus.png"], "nine": [32, 32, 32, 32] },
    { "id": "card_selected", "outs": ["UI/Panels/UI_RewardBlock_Selected.png"], "nine": [32, 32, 32, 32] },
    { "id": "outline", "outs": ["UI/Controls/UI_Outline_Selected.png", "UI/Controls/UI_Outline_Thin_Selected.png"], "nine": [32, 32, 32, 32] },
