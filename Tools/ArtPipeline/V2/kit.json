    { "id": "radio_off", "outs": ["UI/Controls/UI_Radio_Off.png"] },
    { "id": "check", "outs": ["UI/Controls/UI_Check_Badge.png"] },
    { "id": "field", "outs": ["UI/Controls/UI_Field.png", "UI/Controls/UI_Field_Light.png"], "nine": [24, 24, 24, 24] },
