    { "id": "primary", "outs": ["UI/Buttons/UI_ButtonPrimary_Normal.png"], "nine": [56, 0, 56, 0] },
    { "id": "secondary", "outs": ["UI/Buttons/UI_ButtonSecondary_Normal.png"], "nine": [44, 0, 44, 0] },
    { "id": "secondary_box", "outs": ["UI/Table/UI_ButtonSecondary_Box_Normal.png"], "nine": [24, 0, 24, 0] },
    { "id": "disc", "outs": ["UI/Buttons/UI_ButtonDisc_Normal.png"] },
