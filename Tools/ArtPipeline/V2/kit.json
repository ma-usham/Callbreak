    { "id": "name_plate", "outs": ["UI/Table/UI_NamePlate.png"], "nine": [20, 0, 20, 0] },
    { "id": "status_pill", "outs": ["UI/Table/UI_StatusPill.png"], "nine": [22, 0, 22, 0] },
    { "id": "tag_pill", "outs": ["UI/Table/UI_Pill_Tag.png"], "nine": [21, 0, 21, 0] },
    { "id": "timer_pill", "outs": ["UI/Table/UI_Pill_Elapsed.png"], "nine": [30, 0, 30, 0] },
    { "id": "turn_ring", "outs": ["UI/Table/UI_TimerRing.png"] },
    { "id": "bid_chip", "outs": ["UI/Table/UI_Chip_Normal.png"] },
    { "id": "bid_chip_selected", "outs": ["UI/Table/UI_Chip_Selected.png"] }
  ],
  "effects": {
    "panel": [
      { "color": "#3b2412", "alpha": 0.18, "y": 12, "radius": 40 },
      { "color": "#3b2412", "alpha": 0.08, "y": 2, "radius": 6 }
    ],
    "card": [ { "color": "#3b2412", "alpha": 0.16, "y": 4, "radius": 12 } ],
    "icon_button": [ { "color": "#5e3f27", "alpha": 0.22, "y": 4, "radius": 10 } ],
    "primary": [ { "color": "#4e060d", "alpha": 0.35, "y": 6, "radius": 14 } ],
    "secondary": [ { "color": "#5e3f27", "alpha": 0.18, "y": 4, "radius": 10 } ],
    "hero": [ { "color": "#4e060d", "alpha": 0.38, "y": 8, "radius": 18 } ],
    "disc_selected": [
      { "color": "#ddb565", "alpha": 0.55, "y": 0, "radius": 28, "spread": 2 },
      { "color": "#4e060d", "alpha": 0.30, "y": 6, "radius": 14 }
    ]
  },
  "shadows": [
    { "out": "UI/Common/UI_Panel_Large_Shadow.png", "shape": { "w": 0, "h": 0, "r": 32 }, "effects": "panel", "drop": 12, "slice": "both" },
    { "out": "UI/Panels/UI_Panel_Card_Shadow.png", "shape": { "w": 0, "h": 0, "r": 24 }, "effects": "card", "drop": 4, "slice": "both" },
    { "out": "UI/Panels/UI_Popover_Shadow.png", "shape": { "w": 0, "h": 0, "r": 20 }, "effects": "panel", "drop": 12, "slice": "both" },
    { "out": "UI/Panels/UI_Drawer_Shadow.png", "shape": { "w": 267, "h": 0, "radii": [32, 0, 0, 32] }, "effects": "panel", "drop": 12, "slice": "vertical" },
    { "out": "UI/Panels/UI_Popover_Pointer_Shadow.png", "shape": { "face": "pointer" }, "effects": "panel", "drop": 12, "slice": "none" },
    { "out": "UI/Buttons/UI_Shadow_Circle.png", "shape": { "w": 96, "h": 96, "r": 48 }, "effects": "icon_button", "drop": 4, "slice": "none" },
    { "out": "UI/Buttons/UI_Shadow_Primary.png", "shape": { "w": 360, "h": 112, "r": 56 }, "effects": "primary", "drop": 6, "slice": "horizontal", "face": "primary" },
    { "out": "UI/Buttons/UI_Shadow_Secondary.png", "shape": { "w": 220, "h": 88, "r": 44 }, "effects": "secondary", "drop": 4, "slice": "horizontal", "face": "secondary" },
    { "out": "UI/Table/UI_ButtonSecondary_Box_Shadow.png", "shape": { "w": 220, "h": 88, "r": 18 }, "effects": "secondary", "drop": 4, "slice": "horizontal", "face": "secondary_box" },
    { "out": "UI/Controls/UI_Button_Crimson_Shadow.png", "shape": { "w": 600, "h": 104, "r": 28 }, "effects": "hero", "drop": 8, "slice": "horizontal", "face": "hero" },
    { "out": "UI/Controls/UI_Button_Crimson_Box_Shadow.png", "shape": { "w": 600, "h": 104, "r": 28 }, "effects": "hero", "drop": 8, "slice": "horizontal", "face": "hero" },
    { "out": "UI/Buttons/UI_ButtonDisc_Emblem_Shadow.png", "shape": { "w": 160, "h": 160, "r": 80 }, "effects": "disc_selected", "drop": 0, "slice": "none" },
    { "out": "UI/Controls/UI_StakeChip_Shadow.png", "shape": { "w": 200, "h": 84, "r": 42 }, "effects": "secondary", "drop": 4, "slice": "horizontal", "face": "stake" }
  ]
