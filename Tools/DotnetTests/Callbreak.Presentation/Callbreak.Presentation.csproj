<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine-free part of Callbreak.Presentation: the table's logic (hand layout, prompt and status
       copy, the played-events state, the input lock, the results copy), the event queue and the timed
       animation steps. Views, card animations and presenters need UnityEngine and are left out. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Callbreak.Presentation</AssemblyName>
    <RootNamespace>Callbreak.Presentation</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityScripts)\Presentation\Table\Logic\**\*.cs" />
    <Compile Include="$(UnityScripts)\Presentation\Table\Playback\IEventAnimation.cs" />
    <Compile Include="$(UnityScripts)\Presentation\Table\Playback\MatchEventPlayer.cs" />
    <Compile Include="$(UnityScripts)\Presentation\Table\Playback\TimedAnimations.cs" />
    <!-- The screen ids alone (a plain enum): the table's input rule is stated in terms of the router's top screen. -->
    <Compile Include="$(UnityScripts)\Presentation\Framework\ScreenId.cs" />
    <!-- How far a panel rises to keep its text field above the on-screen keyboard (the view that moves it is left out). -->
    <Compile Include="$(UnityScripts)\Presentation\Framework\KeyboardLift.cs" />
    <!-- The shop: the timing of a deck picture's look at its ace, the tile and button rules, the page's
         state and the carousel's positions (the views, the carousel widget and the presenter are left out). -->
    <Compile Include="$(UnityScripts)\Presentation\Screens\Shop\DeckPeek.cs" />
    <Compile Include="$(UnityScripts)\Presentation\Screens\Shop\ShopDisplay.cs" />
    <Compile Include="$(UnityScripts)\Presentation\Screens\Shop\ShopState.cs" />
    <Compile Include="$(UnityScripts)\Presentation\Screens\Shop\CarouselScroll.cs" />
    <!-- Quick Match: what the search screen shows for a report, the seat order and the pill's time (the view and presenter are left out). -->
    <Compile Include="$(UnityScripts)\Presentation\Screens\Matchmaking\MatchmakingDisplay.cs" />
    <Compile Include="$(UnityScripts)\Presentation\Screens\Matchmaking\MatchmakingScreenState.cs" />
    <ProjectReference Include="..\Callbreak.Core\Callbreak.Core.csproj" />
    <ProjectReference Include="..\Callbreak.Bots\Callbreak.Bots.csproj" />
    <ProjectReference Include="..\Callbreak.Application\Callbreak.Application.csproj" />
  </ItemGroup>
</Project>
