  // Cut here (placeholders until the generated kit art arrives): the rule number disc (one cut, used
  // four times), the four rule icons, the A-over-K card illustration and the two ornaments of the
  // "Highest total" pill. Hairlines (the three rule separators) and the pill are vectors in their
  // measured colours. Every word is a label.
  "name": "HowToPlay",
  "mockup": "12-how-to-play.png",
  "background": "shared",
  "nodes": [
    { "id": "BackButton", "kind": "button", "group": "HeaderLeft", "shape": "ellipse", "rect": [39.8, 34.2, 88.4, 87.6],
