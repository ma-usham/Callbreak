    { "id": "Rule3Line1", "kind": "label", "parent": "Panel", "text": "No leading suit? Play a spade if you have one.", "font": "SansSemiBold", "align": "left", "rect": [604, 591, 404, 24], "key": "ui.how_to_play.rule3_line1" },
    { "id": "Separator3", "parent": "Panel", "rect": [438, 634.0, 613, 2.0], "make": { "type": "rect", "fill": "#E8D4C2", "out": "Deco_RuleSeparator_3" } },

