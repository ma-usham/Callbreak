    { "id": "Rule1Line2", "kind": "label", "parent": "Panel", "text": "tricks you will win.", "font": "SansSemiBold", "align": "left", "rect": [604, 415.5, 175, 23], "key": "ui.how_to_play.rule1_line2" },
