    { "id": "Rule4Line2", "kind": "label", "parent": "Panel", "text": "Miss it: −bid.", "font": "SansSemiBold", "align": "left", "rect": [604, 701.5, 120, 20], "key": "ui.how_to_play.rule4_line2" },

