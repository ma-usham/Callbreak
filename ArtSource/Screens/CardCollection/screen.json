{
  // Screen 15 - Card Collection (GDD §11). Rects are mockup pixels on 15-card-styles.png.
  // Shared menu background and UI kit (header discs); the panel, the deck option
  // panels, the title divider and the icons (back, card stack) are the generated kit
  // (ArtSource/Kit/*.map.csv; an icon's "opacity" is the one at which the kit's black ink reads as
  // this mockup's ink). The deck pictures are the real card backs (Art/Cards), shown with their own
  // proportions inside the mockup's card boxes; the presenter flips them to each deck's ace of
  // spades. The selected outline, the two radio looks and the Use button (the plain crimson pill)
  // are the kit's (UI/Controls). Still solved
  // from this mockup: the soft shadows under the deck pictures.
  // Footer and button copy: the GDD's copy update wins ("text" below is the GDD's wording, so the
  // string table gets it). The mockup says "Choose a card back for your next match." and "Use
  // Selected Style"; CardCollectionCustomizer fits the two labels on that wording, so they keep the
  // mockup's size, width scale, baseline and centre, and the width follows the new text.
  "name": "CardCollection",
  "mockup": "15-card-styles.png",
  "background": "shared",
  "nodes": [
    { "id": "BackButton", "kind": "button", "group": "HeaderLeft", "shape": "ellipse", "rect": [39.1, 32.1, 91.6, 91.6],
      "use": "UI/Buttons/UI_ButtonCircle_Normal.png", "shadowUse": "UI/Buttons/UI_Shadow_Circle.png", "shadowDrop": 3.5, "shadowOpacity": 0.2 },
    { "id": "BackIcon", "parent": "BackButton", "rect": [65.06, 58.81, 39.62, 38.76], "use": "UI/Icons/Icon_Back.png" },
    { "id": "CollectionButton", "kind": "button", "group": "HeaderRight", "shape": "ellipse", "rect": [1542.8, 31.8, 91.4, 91.4],
      "use": "UI/Buttons/UI_ButtonCircle_Normal.png", "shadowUse": "UI/Buttons/UI_Shadow_Circle.png", "shadowDrop": 3.5, "shadowOpacity": 0.2 },
    { "id": "CollectionIcon", "parent": "CollectionButton", "rect": [1566.08, 53.18, 48.66, 48.66], "use": "UI/Icons/Icon_CardStack.png", "opacity": 0.99 },

    { "id": "Title", "kind": "label", "text": "Card Collection", "font": "SerifBold", "rect": [555, 50, 565, 82], "key": "ui.card_collection.title" },
    { "id": "Subtitle", "kind": "label", "text": "A LITTLE NEPAL IN EVERY HAND", "font": "SansSemiBold", "tracked": true, "rect": [530, 133, 615, 30], "key": "ui.card_collection.subtitle" },
    { "id": "TitleDivider", "rect": [676.1, 173.2, 321.3, 12.7], "use": "UI/Decor/Deco_TitleDivider.png" },

    { "id": "Panel", "shape": "roundrect", "radius": 23, "rect": [367.0, 197.5, 938.7, 558.5],
      "use": "UI/Panels/UI_Panel_Large.png", "shadowUse": "UI/Common/UI_Panel_Large_Shadow.png", "shadowSpread": 24, "shadowDrop": 3 },

    // Three deck options (SelectableGroup "Decks"): selected look = outline + filled radio,
