    { "id": "UseLabel", "kind": "label", "parent": "UseButton", "text": "Use Selected Deck", "font": "SerifSemiBold", "ink": "light", "style": "buttonLabel", "rect": [675, 795, 320, 50], "key": "ui.card_collection.use" }
