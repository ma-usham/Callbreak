    { "id": "DeckPreview0", "parent": "DeckOption0", "shape": "roundrect", "radius": 11, "rect": [443.5, 245.8, 184.0, 281.0], "shadow": 12, "use": "Cards/ClassicCrimson/Back_ClassicCrimson.png", "bind": "DeckCard0" },
