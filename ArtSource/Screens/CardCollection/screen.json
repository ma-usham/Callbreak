    // A DeckPreview node is bound twice: its picture is the view's _deckPreview, and the node itself
    // (picture + shadow, "bind": DeckCard) is what turns when the deck shows its ace (_deckCard).
    { "id": "Decks", "kind": "group", "parent": "Panel", "rect": [389, 218, 894, 460] },

    { "id": "DeckOption0", "kind": "button", "parent": "Decks", "shape": "roundrect", "radius": 23, "rect": [393.5, 221.8, 284.9, 451.9],
