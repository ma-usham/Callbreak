  // opacity that gives this mockup's ink colour in the middle of a stroke (the generated icons are pure
  // black; the map's "mockup ink" averages in the soft stroke edges, which is too light for thin strokes).
  // The older shared icons and the logo keep their own proportions (rects from
  // ArtSource/Working/CreateRoom/derive/derive.sh tool fiticon|fitlogo: the sprite's glyph centred on this
  // mockup's glyph at one scale).
  "name": "PrivateLobby",
  "mockup": "04-private-lobby.png",
  "background": "shared",
  "nodes": [
