{
  // The Shop's Backgrounds category (mockup 20) - a measurement job, not a screen of its own: the
  // Shop prefab is built from ArtSource/Screens/Shop, and ShopCustomizer reads this layout for the
  // Backgrounds title, subtitle, tiles, status row, chevrons, primary label and the drawer's
  // Backgrounds-active / Cards-inactive looks (rects from ArtSource/Working/ShopUI/notes.md).
  // Never build it with screen.sh. Sprites cut here land in Art/Screens/Shop ("outDir").
  //
  // The thumbnails are the generated ones (ArtSource/Working/ShopBackgroundsA|B/final, imported as
  // Art/Shop/Backgrounds/Thumb_<Name>.png): square corners, rounded by the tile's frame.
  "name": "ShopBackgroundsLayout",
  "mockup": "20-backgrounds.png",
  "background": "shared",
  "outDir": "Screens/Shop",
  "nodes": [
    { "id": "Title1", "kind": "label", "text": "Background Collection", "font": "SerifBold", "rect": [482, 48, 708, 86], "key": "ui.shop.backgrounds.title" },
    { "id": "Subtitle1", "kind": "label", "text": "CHOOSE YOUR VIEW", "font": "SansSemiBold", "tracked": true, "rect": [650, 133, 372, 31], "key": "ui.shop.backgrounds.subtitle" },

    { "id": "Panel", "shape": "roundrect", "radius": 24.5, "rect": [329.0, 198.7, 978.0, 537.1], "use": "UI/Panels/UI_Panel_Card.png", "sliceScale": 0.898,
      "shadowUse": "UI/Common/UI_Panel_Card_Shadow.png", "shadowSpread": 12, "shadowDrop": 2 },

