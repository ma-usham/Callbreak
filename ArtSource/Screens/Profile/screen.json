{
  // Screen 14 - Player Profile (GDD §11). Rects are mockup pixels on 14-profile.png.
  // Shared menu background and UI kit (back disc, avatar); the panel, the stat tiles,
  // the title divider, the two dividers inside the panel and the icons (back, pencil, the four stat
  // icons) are the generated kit (ArtSource/Kit/*.map.csv; an icon's "opacity" is the one at which
  // the kit's black ink reads as this mockup's ink), and so are the name field and the Save button
  // (the plain crimson pill; UI/Controls). Nothing is cut from this mockup any more.
  "name": "Profile",
  "mockup": "14-profile.png",
  "background": "shared",
  "nodes": [
    { "id": "BackButton", "kind": "button", "group": "HeaderLeft", "shape": "ellipse", "rect": [41.6, 34.1, 88.4, 88.4],
      "use": "UI/Buttons/UI_ButtonCircle_Normal.png", "shadowUse": "UI/Buttons/UI_Shadow_Circle.png", "shadowDrop": 3.5, "shadowOpacity": 0.2 },
    { "id": "BackIcon", "parent": "BackButton", "rect": [66.58, 59.61, 39.59, 38.73], "use": "UI/Icons/Icon_Back.png" },

    { "id": "Title", "kind": "label", "text": "Your Profile", "font": "SerifBold", "rect": [615, 55, 445, 74], "key": "ui.profile.title" },
    // The generated title divider, built from parts (ArtSource/Kit/Decor.title-divider.csv): the diamond
    // at its own size and the line sprite stretched to this mockup's line length, as it is on the right
    // and mirrored on the left ("mirror", applied by ScreenExtras.Apply from the customizer).
    { "id": "TitleLineLeft", "rect": [714.7, 134.8, 115.2, 3.4], "use": "UI/Decor/Deco_TitleDivider_Line.png", "mirror": true },
    { "id": "TitleDiamond", "rect": [829.7, 130.2, 12.7, 12.7], "use": "UI/Decor/Deco_TitleDivider_Diamond.png" },
    { "id": "TitleLineRight", "rect": [842.1, 134.8, 98.5, 3.4], "use": "UI/Decor/Deco_TitleDivider_Line.png" },
    { "id": "Subtitle", "kind": "label", "text": "EVERY HAND TELLS A STORY", "font": "SansBold", "tracked": true, "rect": [555, 145, 570, 30], "key": "ui.profile.subtitle" },

    { "id": "Panel", "shape": "roundrect", "radius": 28.5, "rect": [383.7, 195.0, 904.2, 675.6],
      "use": "UI/Panels/UI_Panel_Large.png", "shadowUse": "UI/Common/UI_Panel_Large_Shadow.png", "shadowSpread": 24, "shadowDrop": 3 },

    // The player's avatar (the shared avatar sprites, scaled to this rect) and the edit pencil.
    { "id": "AvatarRing", "kind": "button", "bind": "AvatarButton", "parent": "Panel", "shape": "ellipse", "rect": [477.31, 255.06, 215.6, 215.6],
      "use": "UI/Avatars/UI_AvatarRing.png", "shadowUse": "UI/Buttons/UI_Shadow_Circle.png", "shadowDrop": 5, "shadowOpacity": 0.15 },
    { "id": "Avatar", "parent": "AvatarRing", "shape": "ellipse", "rect": [481.24, 258.88, 208.3, 208.3], "use": "UI/Avatars/Avatar_Default.png" },
    { "id": "EditAvatarButton", "kind": "button", "parent": "Panel", "shape": "ellipse", "rect": [639.7, 399.7, 67.0, 67.0],
      "use": "UI/Buttons/UI_ButtonCircle_Normal.png", "shadowUse": "UI/Buttons/UI_Shadow_Circle.png", "shadowDrop": 3.5, "shadowOpacity": 0.2 },
    { "id": "EditAvatarIcon", "parent": "EditAvatarButton", "rect": [657.02, 417.12, 33.05, 33.05], "use": "UI/Icons/Icon_Pencil.png", "opacity": 0.992 },
    { "id": "PlayerName", "kind": "label", "parent": "Panel", "text": "Player", "font": "SerifBold", "rect": [505, 475, 160, 55] },
    { "id": "Tagline", "kind": "label", "parent": "Panel", "text": "Callbreak enthusiast", "font": "SansSemiBold", "rect": [458, 532, 255, 34], "key": "ui.profile.tagline" },

    { "id": "StatsDivider", "parent": "Panel", "rect": [746.6, 260.8, 13.3, 290.8], "use": "UI/Decor/Deco_ProfileDividerVertical.png" },

    // Stat tiles: icon, caption (fixed copy), value (dynamic). The generated kit card's corners are
    // drawn for radius 21.5; sliceScale 1.2 gives these tiles' radius of about 18.
    { "id": "Tile0", "parent": "Panel", "shape": "roundrect", "radius": 19.5, "rect": [787.1, 260.4, 235.0, 120.1], "sliceScale": 1.2,
      "use": "UI/Panels/UI_Panel_Card.png", "shadowUse": "UI/Common/UI_Panel_Card_Shadow.png", "shadowSpread": 12, "shadowDrop": 2 },
    { "id": "Tile0Icon", "parent": "Tile0", "rect": [803.01, 283.42, 61.71, 66.06], "use": "UI/Icons/Icon_StatGames.png", "opacity": 0.985 },
    { "id": "Tile0Caption", "kind": "label", "parent": "Tile0", "text": "Games played", "font": "SansBold", "align": "left", "rect": [875, 282, 140, 26], "key": "ui.profile.games_played" },
    { "id": "Stat0", "kind": "label", "parent": "Tile0", "text": "48", "font": "SansBold", "align": "left", "rect": [875, 316, 70, 44] },

    { "id": "Tile1", "parent": "Panel", "shape": "roundrect", "radius": 17, "rect": [1040.7, 260.9, 220.2, 119.5], "sliceScale": 1.2,
      "use": "UI/Panels/UI_Panel_Card.png", "shadowUse": "UI/Common/UI_Panel_Card_Shadow.png", "shadowSpread": 12, "shadowDrop": 2 },
    { "id": "Tile1Icon", "parent": "Tile1", "rect": [1063.84, 286.29, 57.4, 60.88], "use": "UI/Icons/Icon_StatWins.png", "opacity": 0.989 },
    { "id": "Tile1Caption", "kind": "label", "parent": "Tile1", "text": "Wins", "font": "SansBold", "align": "left", "rect": [1135, 282, 60, 26], "key": "ui.profile.wins" },
    { "id": "Stat1", "kind": "label", "parent": "Tile1", "text": "19", "font": "SansBold", "align": "left", "rect": [1135, 316, 60, 44] },

    { "id": "Tile2", "parent": "Panel", "shape": "roundrect", "radius": 17.5, "rect": [787.1, 400.8, 235.0, 120.3], "sliceScale": 1.2,
      "use": "UI/Panels/UI_Panel_Card.png", "shadowUse": "UI/Common/UI_Panel_Card_Shadow.png", "shadowSpread": 12, "shadowDrop": 2 },
    { "id": "Tile2Icon", "parent": "Tile2", "rect": [808.87, 432.48, 53.83, 55.57], "use": "UI/Icons/Icon_StatWinRate.png", "opacity": 0.989 },
    { "id": "Tile2Caption", "kind": "label", "parent": "Tile2", "text": "Win rate", "font": "SansBold", "align": "left", "rect": [875, 423, 95, 26], "key": "ui.profile.win_rate" },
    { "id": "Stat2", "kind": "label", "parent": "Tile2", "text": "40%", "font": "SansBold", "align": "left", "rect": [875, 456, 95, 46] },

    { "id": "Tile3", "parent": "Panel", "shape": "roundrect", "radius": 17, "rect": [1040.8, 401.1, 219.4, 119.9], "sliceScale": 1.2,
      "use": "UI/Panels/UI_Panel_Card.png", "shadowUse": "UI/Common/UI_Panel_Card_Shadow.png", "shadowSpread": 12, "shadowDrop": 2 },
    { "id": "Tile3Icon", "parent": "Tile3", "rect": [1062.11, 428.04, 60.89, 60.02], "use": "UI/Icons/Icon_StatBestScore.png", "opacity": 0.989 },
    { "id": "Tile3Caption", "kind": "label", "parent": "Tile3", "text": "Best score", "font": "SansBold", "align": "left", "rect": [1135, 423, 110, 26], "key": "ui.profile.best_score" },
    { "id": "Stat3", "kind": "label", "parent": "Tile3", "text": "26.4", "font": "SansBold", "align": "left", "rect": [1135, 456, 95, 46] },

    { "id": "NameDivider", "parent": "Panel", "rect": [451.8, 586.6, 767.9, 16.1], "use": "UI/Decor/Deco_ProfileDivider.png" },

    { "id": "DisplayNameCaption", "kind": "label", "parent": "Panel", "text": "Display name", "font": "SansSemiBold", "align": "left", "rect": [510, 615, 150, 30], "key": "ui.profile.display_name" },
    // The name field (the kit's light text field); the customizer builds a TMP_InputField over it with
    // FieldText as its text.
    { "id": "NameField", "kind": "input", "parent": "Panel", "shape": "roundrect", "radius": 13.5, "rect": [508.63, 647.55, 654.35, 59.6], "use": "UI/Controls/UI_Field_Light.png" },
    { "id": "FieldText", "kind": "label", "parent": "NameField", "text": "Player", "font": "SansBold", "align": "left", "rect": [525, 660, 90, 34] },

    { "id": "SaveButton", "kind": "button", "parent": "Panel", "shape": "roundrect", "radius": 27.5, "rect": [508.13, 733.7, 655.74, 78.74],
      "use": "UI/Controls/UI_Button_Crimson.png", "shadowUse": "UI/Controls/UI_Button_Crimson_Shadow.png", "shadowDrop": 6, "shadowOpacity": 0.15 },
    { "id": "SaveLabel", "kind": "label", "parent": "SaveButton", "text": "Save Changes", "font": "SerifSemiBold", "ink": "light", "style": "buttonLabel", "rect": [725, 752, 220, 42], "key": "ui.profile.save" },
    { "id": "NameMessage", "kind": "label", "parent": "Panel", "text": "Your name is visible at the table.", "font": "SansMedium", "rect": [680, 822, 315, 30], "key": "ui.profile.name_note" }
  ]
}
