  // black ink reads as this mockup's ink), and so are the selected outline and the check badge
  // (UI/Controls), the Start button (the plain crimson pill) and its thin chevron. Nothing is cut
  // from this mockup any more. Hairlines are "make" shapes.
  "name": "OfflineSetup",
  "mockup": "06-offline-setup.png",
  "background": "shared",
  "nodes": [
