{
  // The Shop's Tables category (mockup 21) - a measurement job, not a screen of its own: the Shop
  // prefab is built from ArtSource/Screens/Shop, and ShopCustomizer reads this layout for the Tables
  // title, subtitle, tiles, the price row (coin + price), the "Buy for" row of the primary button
  // and the drawer's Tables-active look (rects from ArtSource/Working/ShopUI/notes.md). Never build
  // it with screen.sh. Sprites cut here land in Art/Screens/Shop.
  //
  // The table previews are the generated ones (ArtSource/Working/ShopTables/final, imported as
  // Art/Shop/Tables/Preview_<Name>.png, transparent with a soft contact shadow): each covers a
  // 262 x 275 area centred on its tile (the ShopTables agent's placement).
  "name": "ShopTablesLayout",
  "mockup": "21-table-styles.png",
  "background": "shared",
  "outDir": "Screens/Shop",
  "nodes": [
    { "id": "Title2", "kind": "label", "text": "Table Collection", "font": "SerifBold", "rect": [540, 44, 590, 88], "key": "ui.shop.tables.title" },
    { "id": "Subtitle2", "kind": "label", "text": "MAKE EVERY HAND FEEL SPECIAL", "font": "SansSemiBold", "tracked": true, "rect": [510, 133, 652, 32], "key": "ui.shop.tables.subtitle" },

    { "id": "Panel", "shape": "roundrect", "radius": 25.5, "rect": [328.6, 198.1, 978.4, 538.2], "use": "UI/Panels/UI_Panel_Card.png", "sliceScale": 0.898,
      "shadowUse": "UI/Common/UI_Panel_Card_Shadow.png", "shadowSpread": 12, "shadowDrop": 2 },

    // Tile 0 Equipped (filled radio), tile 1 chosen and not owned (outline, coin and price), tile 2 not owned.
    { "id": "Tile0", "kind": "button", "parent": "Panel", "shape": "roundrect", "radius": 19.5, "rect": [399.8, 224.1, 266.1, 426.9],
      "use": "UI/Panels/UI_Panel_Card_Light.png", "sliceScale": 1.157, "shadowUse": "UI/Common/UI_Panel_Card_Shadow.png", "shadowSpread": 12, "shadowDrop": 2 },
    { "id": "TablePicture0", "parent": "Tile0", "rect": [401.85, 262, 262, 275], "use": "Shop/Tables/Preview_HimalayanIvory.png" },
    { "id": "Name0", "kind": "label", "parent": "Tile0", "text": "Himalayan Ivory", "font": "SerifBold", "rect": [420, 537, 226, 44] },
    { "id": "RadioOn0", "parent": "Tile0", "rect": [458.4, 588.1, 40.4, 40.4], "use": "UI/Controls/UI_Radio_On.png" },
    { "id": "Status0", "kind": "label", "parent": "Tile0", "text": "Equipped", "font": "SansMedium", "align": "left", "rect": [506, 592, 112, 35] },

    { "id": "Tile1", "kind": "button", "parent": "Panel", "shape": "roundrect", "radius": 21, "rect": [683.4, 224.4, 268.5, 427.1],
