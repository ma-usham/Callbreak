    { "id": "NextIcon", "parent": "NextButton", "shape": "ink", "rect": [1253, 410, 30, 38], "use": "UI/Icons/Icon_Chevron.png" },
    { "id": "SwipeHint", "kind": "label", "parent": "Panel", "text": "Swipe to browse", "font": "SansRegular", "rect": [747, 694, 178, 33] },

    // "Buy for" + coin + price on the primary button.
    { "id": "PrimaryButton", "kind": "button", "shape": "roundrect", "radius": 41.5, "rect": [562.9, 764.4, 545.9, 93.7],
      "use": "UI/Controls/UI_Button_Crimson.png", "shadowUse": "UI/Controls/UI_Button_Crimson_Shadow.png", "shadowDrop": 6, "shadowOpacity": 0.25 },
    { "id": "BuyLabel", "kind": "label", "parent": "PrimaryButton", "text": "Buy for", "font": "SerifSemiBold", "ink": "light", "style": "buttonLabel", "align": "left",
      "rect": [700, 786, 136, 54], "key": "ui.shop.buy_for" },
    { "id": "BuyCoin", "parent": "PrimaryButton", "rect": [839.93, 786.28, 46.75, 46.75], "use": "UI/Icons/Icon_Coin.png" },
    { "id": "BuyPrice", "kind": "label", "parent": "PrimaryButton", "text": "350", "font": "SerifSemiBold", "ink": "light", "style": "buttonLabel", "align": "left",
      "rect": [892, 788, 80, 44] },

    // The drawer with Tables active: the crimson disc and the ivory table.
    { "id": "Drawer", "group": "HeaderRight", "rect": [1439.8, -0.8, 232.2, 942.6], "use": "UI/Panels/UI_Drawer.png" },
    { "id": "CategoryLabel0", "kind": "label", "parent": "Drawer", "text": "Cards", "font": "SerifSemiBold", "rect": [1512, 365, 98, 40] },
    { "id": "CategoryLabel1", "kind": "label", "parent": "Drawer", "text": "Backgrounds", "font": "SerifSemiBold", "rect": [1480, 571, 162, 43] },
    { "id": "CategoryButton2", "kind": "button", "parent": "Drawer", "shape": "ellipse", "rect": [1490.18, 634.73, 139.55, 139.55], "use": "UI/Buttons/UI_ButtonDisc_Selected.png" },
    { "id": "CategoryIcon2", "parent": "CategoryButton2", "rect": [1513.53, 681.26, 92.85, 61.88], "use": "UI/Icons/Icon_TableOval_Ivory.png" },
    { "id": "CategoryLabel2", "kind": "label", "parent": "Drawer", "text": "Tables", "font": "SerifSemiBold", "rect": [1514, 779, 94, 36] }
  ]
